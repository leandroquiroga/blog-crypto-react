# ============================================================
# Firebase Web App (publicas por diseno del SDK, prefijo VITE_)
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# CryptoCompare - SOLO SERVIDOR
# Nombres recomendados (sin prefijo VITE_, nunca van al navegador)
# ============================================================
BASE_URL_CRYPTO_COMPARE=https://min-api.cryptocompare.com
PATH_URL_NEWS_CRYPTO_COMPARE=/data/v2/news/
API_KEY_CRYPTO_COMPARE=*******************************

# El proxy tambien acepta las variantes con prefijo:
#   VITE_BASE_URL_CRYPTO_COMPARE
#   VITE_PATH_URL_NEWS_CRYPTO_COMPARE
#   VITE_API_KEY_CRYPTO_COMPARE
# En desarrollo el navegador puede leer esas variables, por eso NO se recomiendan.

# Endpoint del proxy (mismo origen por defecto).
# Si el proxy vive en otro dominio, usar la URL absoluta de la funcion.
VITE_CRYPTOCOMPARE_API_URL=/api/cryptocompare

# ============================================================
# CoinGecko - SOLO SERVIDOR (la key nunca va al navegador)
# ============================================================
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Cliente: endpoint del proxy de CoinGecko
VITE_COINGECKO_API_URL=/api/coingecko

# ============================================================
# OpenRouter - SOLO SERVIDOR (la key nunca va al navegador)
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173

# Origen(es) permitidos para /api/ai (coma-separados). Vacio = no valida Origin.
AI_ALLOWED_ORIGINS=http://localhost:5173

# Cliente: endpoint de los analisis IA
VITE_AI_API_URL=/api/ai

# Origen(es) permitidos para los proxies publicos (/api/cryptocompare, /api/coingecko).
# Coma-separados. Vacio = no valida Origin.
ALLOWED_ORIGINS=http://localhost:5173
